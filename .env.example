# 复制为 .env 后按需修改： cp .env.example .env
#
# 前台 API 基础地址（聊天 / 会话 / RAG / 技能 / 用户）。
# 生产部署时改成真实后端地址，例如 https://api.your-domain.com/api/v1
VITE_AUTH_API_URL=http://localhost:8080/api/v1

# 后台管理 API 基础地址（可选）。
# 不设置时自动取 = VITE_AUTH_API_URL + "/admin"
# VITE_ADMIN_API_URL=http://localhost:8080/api/v1/admin
